# ============================================================
# FITDEALFINDER ENVIRONMENT
# ============================================================

# Database
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/fitdealfinder

# Awin
AWIN_API_KEY=YOUR_AWIN_API_KEY
AWIN_PUBLISHER_ID=YOUR_AWIN_PUBLISHER_ID
AWIN_PRODUCT_FEED_URL=https://YOUR-AWIN-FEED-URL

# Admin
# Gebruik hier later een lange willekeurige geheime waarde.
ADMIN_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Server
PORT=3000

# Alleen true zetten wanneer je hosting achter een vertrouwde proxy staat.
TRUST_PROXY=false

# Production / development
NODE_ENV=production
