# ============================================================
# FITDEALFINDER
# ============================================================

# PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/fitdealfinder

# ============================================================
# AWIN
# ============================================================
# Nog niet invullen zolang je geen Awin-account/gegevens hebt.

AWIN_API_KEY=YOUR_AWIN_API_KEY
AWIN_PUBLISHER_ID=YOUR_AWIN_PUBLISHER_ID
AWIN_PRODUCT_FEED_URL=https://YOUR-AWIN-FEED-URL

# ============================================================
# ADMIN
# ============================================================
# Gebruik minimaal 32 willekeurige tekens.
ADMIN_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# ============================================================
# SERVER
# ============================================================

PORT=3000

# Alleen true gebruiken wanneer de server achter
# een vertrouwde reverse proxy staat.
TRUST_PROXY=false

NODE_ENV=production
