{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "fitdealfinder",
  "main": "worker.ts",
  "compatibility_date": "2026-09-04",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitdealfinder-db",
      "database_id": "12942f1e-0caa-4835-aa18-b425228cad53",
      "migrations_dir": "migrations"
    }
  ],

  "ai": {
    "binding": "AI"
  }
}
