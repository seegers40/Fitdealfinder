{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fitdealfinder",
  "main": "worker.ts",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitdealfinder-db",
      "database_id": "VUL_HIER_LATER_HET_ECHTE_D1_DATABASE_ID_IN",
      "migrations_dir": "migrations"
    }
  ]
}
